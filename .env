# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env

# --- Database (MySQL) ---
MYSQL_DATABASE=keluhkesah
MYSQL_USER=keluh
MYSQL_PASSWORD=koboy123456
MYSQL_ROOT_PASSWORD=koboy1234567

# --- Aplikasi ---
# String acak panjang untuk menandatangani token login (JWT). Tiap pengguna
# daftar & login dengan akun sendiri (username/password), bukan satu password bersama.
JWT_SECRET=izintampil

# --- Port di komputer host ---
WEB_PORT=8080
ADMINER_PORT=8081

# --- Opsional: username Docker Hub (untuk docker compose push) ---
DOCKERHUB_USER=narasandrone
