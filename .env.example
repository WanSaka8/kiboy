# --- Database (MySQL) ---
MYSQL_DATABASE=keluhkesah
MYSQL_USER=keluh
MYSQL_PASSWORD=ganti_password_db
MYSQL_ROOT_PASSWORD=ganti_password_root

# --- Aplikasi ---
# String acak panjang untuk menandatangani token login (JWT).
JWT_SECRET=ganti_dengan_string_acak_yang_panjang

# --- Port di komputer host ---
WEB_PORT=8080
ADMINER_PORT=8081

# --- Username Docker Hub (nama image: <user>/izinkompe:backend & :frontend) ---
DOCKERHUB_USER=narasandrone
